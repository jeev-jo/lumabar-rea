{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "luma-ai-bar",
  "version": "0.1.0",
  "identifier": "dev.lumaaibar.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "luma-ai-bar",
        "width": 800,
        "height": 60,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false,
        "maximizable": false,
        "minimizable": false
      },
      {
        "label": "preview",
        "title": "luma-ai-bar preview",
        "width": 260,
        "height": 200,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false,
        "maximizable": false,
        "minimizable": false,
        "url": "index.html?view=preview"
      },
      {
        "label": "settings",
        "title": "luma-ai-bar settings",
        "url": "index.html?view=settings",
        "width": 560,
        "height": 660,
        "minWidth": 460,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "resizable": true
      },
      {
        "label": "popover",
        "title": "luma-ai-bar widget",
        "width": 320,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": true,
        "dragDropEnabled": false,
        "maximizable": false,
        "minimizable": false,
        "url": "index.html?view=popover"
      },
      {
        "label": "widgets",
        "title": "luma-ai-bar widgets",
        "url": "index.html?view=widgets",
        "width": 820,
        "height": 680,
        "minWidth": 560,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}