{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "luma-ai-bar",
  "version": "0.2.4",
  "identifier": "dev.lumaaibar.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "luma-ai-bar",
        "width": 800,
        "height": 60,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false,
        "maximizable": false,
        "minimizable": false
      },
      {
        "label": "preview",
        "title": "luma-ai-bar preview",
        "width": 260,
        "height": 200,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false,
        "maximizable": false,
        "minimizable": false,
        "url": "index.html?view=preview"
      },
      {
        "label": "settings",
        "title": "luma-ai-bar settings",
        "url": "index.html?view=settings",
        "width": 880,
        "height": 640,
        "minWidth": 520,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "resizable": true,
        "transparent": true
      },
      {
        "label": "popover",
        "title": "luma-ai-bar widget",
        "width": 320,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": true,
        "dragDropEnabled": false,
        "maximizable": false,
        "minimizable": false,
        "url": "index.html?view=popover"
      },
      {
        "label": "widgets",
        "title": "luma-ai-bar widgets",
        "url": "index.html?view=widgets",
        "width": 980,
        "height": 700,
        "minWidth": 680,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "resizable": true,
        "dragDropEnabled": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "luma-ai-bar",
    "shortDescription": "A dock for Windows with widgets and AI usage.",
    "category": "Utility"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0MUQ3M0RDRjg2OTEwOUEKUldTYUVHbjQzSE1kTkc4a2VNczZIaFp4STBoZEJwSlI1VWIxTHRpNnh4bC9QeU5VcG5IeXUzTnIK",
      "endpoints": [
        "https://github.com/jeev-jo/lumabar-rea/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
